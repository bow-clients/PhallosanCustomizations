<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="PhallosanCustomizations\Service\CustomPriceCartProcessorService">
            <argument type="service" id="currency.repository"/>
        </service>

        <service id="PhallosanCustomizations\Service\CustomCashRoundingService"
                 class="PhallosanCustomizations\Service\CustomCashRoundingService"
                 decorates="Shopware\Core\Checkout\Cart\Price\CashRounding">
            <argument type="service" id="PhallosanCustomizations\Service\CustomCashRoundingService.inner"/>
            <argument type="service" id="currency.repository"/>
        </service>

    </services>
</container>
