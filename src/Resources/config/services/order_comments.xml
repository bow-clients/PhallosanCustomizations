<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>

        <!-- Order Comment Entity Definition -->
        <service id="PhallosanCustomizations\Core\Content\OrderComment\OrderCommentDefinition">
            <tag name="shopware.entity.definition" entity="order_comment"/>
        </service>

        <!-- Order Extension -->
        <service id="PhallosanCustomizations\Core\Content\Order\OrderExtension">
            <tag name="shopware.entity.extension"/>
        </service>
    </services>

</container>
