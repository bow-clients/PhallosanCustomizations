<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="PhallosanCustomizations\Core\Checkout\Customer\Validation\Constraint\CustomerPhoneNumberValidator">
            <argument type="service" id="country.repository"/>
            <tag name="validator.constraint_validator"/>
        </service>

        <service id="PhallosanCustomizations\Core\Checkout\Customer\Subscriber\PhoneValidationSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>

    </services>
</container>
