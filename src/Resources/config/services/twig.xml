<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>

        <service id="PhallosanCustomizations\Core\Framework\Twig\HrefPrefixer">
            <argument type="service" id="request_stack"/>
            <tag name="twig.extension"/>
        </service>

        <service id="PhallosanCustomizations\Core\Framework\Twig\SalutationExtension">
            <argument type="service" id="salutation.repository"/>
            <tag name="twig.extension"/>
        </service>

        <service id="PhallosanCustomizations\Core\Framework\Twig\ProductMedia">
            <argument type="service" id="product.repository"/>
            <tag name="twig.extension"/>
        </service>

        <service id="PhallosanCustomizations\Core\Framework\Twig\CountriesExtension">
            <argument type="service" id="sales_channel.repository"/>
            <tag name="twig.extension"/>
        </service>

        <service id="PhallosanCustomizations\Core\Framework\Twig\LanguageSwitchExtension">
            <argument type="service" id="sales_channel_domain.repository"/>
            <argument type="service" id="country.repository"/>
            <argument type="service" id="PhallosanCustomizations\Service\CountrySalesChannelMappingService"/>
            <tag name="twig.extension"/>
        </service>

        <service id="PhallosanCustomizations\Core\Framework\Twig\CustomsDutyExtension">
            <argument type="service" id="tax_rule.repository"/>
            <tag name="twig.extension"/>
        </service>

        <service id="PhallosanCustomizations\Core\Framework\Twig\ImportVatExtension">
            <argument type="service" id="tax_rule.repository"/>
            <tag name="twig.extension"/>
        </service>

        <service id="PhallosanCustomizations\Core\Framework\Twig\FixStripePricesExtension">
            <tag name="twig.extension"/>
        </service>

        <service id="PhallosanCustomizations\Core\Framework\Twig\CreateRequestDataBagExtension">
            <tag name="twig.extension"/>
        </service>
    </services>
</container>
