<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>

        <!-- Importer -->

        <service id="PhallosanCustomizations\Import\ImportShippingPricesService">
            <argument type="service" id="PhallosanCustomizations\Import\Service\ImportConfigurationService"/>
            <argument type="service" id="PhallosanCustomizations\Import\Service\ImportShippingCostsCsvFileReader"/>
            <argument type="service" id="PhallosanCustomizations\Import\Repository\ImportCountryRepository"/>
            <argument type="service" id="PhallosanCustomizations\Import\Repository\ImportSalesChannelRepository"/>
            <argument type="service" id="PhallosanCustomizations\Import\Repository\ImportRuleConditionRepository"/>
            <argument type="service" id="PhallosanCustomizations\Import\Repository\ImportShippingMethodPriceRepository"/>
            <argument type="service" id="PhallosanCustomizations\Import\Storer\ImportShippingMethodPriceStorer"/>
            <argument type="service" id="monolog.logger"/>
        </service>


        <!-- Service -->

        <service id="PhallosanCustomizations\Import\Service\ImportConfigurationService">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="PhallosanCustomizations\Import\Service\ImportShippingCostsCsvFileReader">
            <argument type="service" id="serializer"/>
        </service>


        <!-- Storer -->

        <service id="PhallosanCustomizations\Import\Storer\ImportShippingMethodPriceStorer">
            <argument type="service" id="shipping_method_price.repository"/>
        </service>


        <!-- Repository -->

        <service id="PhallosanCustomizations\Import\Repository\ImportCountryRepository">
            <argument type="service" id="country.repository"/>
        </service>

        <service id="PhallosanCustomizations\Import\Repository\ImportSalesChannelRepository">
            <argument type="service" id="sales_channel.repository"/>
        </service>

        <service id="PhallosanCustomizations\Import\Repository\ImportRuleConditionRepository">
            <argument type="service" id="rule_condition.repository"/>
        </service>

        <service id="PhallosanCustomizations\Import\Repository\ImportShippingMethodPriceRepository">
            <argument type="service" id="shipping_method_price.repository"/>
        </service>

    </services>
</container>
